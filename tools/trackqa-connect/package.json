    "dist/tools/trackqa-connect/src/clients/claude-session.js",
    "dist/tools/trackqa-connect/src/clients/claude.js",
    "dist/tools/trackqa-connect/src/clients/codex-verify.js",
    "dist/tools/trackqa-connect/src/clients/codex.js",
    "dist/tools/trackqa-connect/src/clients/gemini-config.js",
    "dist/tools/trackqa-connect/src/clients/gemini-verify.js",
