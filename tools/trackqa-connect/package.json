{
  "name": "@trackqa/connect-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "dev": "node --experimental-strip-types src/cli.ts",
    "test": "node --experimental-strip-types --experimental-test-isolation=none --test tests/*.test.mjs",
    "check": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "start": "node dist/tools/trackqa-connect/src/cli.js",
    "lint": "node ../../node_modules/oxlint/bin/oxlint src tests"
  },
  "dependencies": { "@supabase/supabase-js": "2.113.0" }
}
