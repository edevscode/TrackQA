VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Cloudinary — unsigned upload only. Never put an API secret or a
# cloudinary://key:secret@cloud URL behind a VITE_ prefix; anything
# VITE_-prefixed is bundled into the client and visible to anyone.
# Create an UNSIGNED upload preset in the Cloudinary dashboard
# (Settings -> Upload -> Upload presets -> Add upload preset -> Signing Mode: Unsigned)
# and put its name below.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset-name
